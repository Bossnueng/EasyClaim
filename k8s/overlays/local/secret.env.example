# local (Docker Desktop) ไม่ใช้ Vault — คัดลอกเป็น secret.env (ไม่ขึ้น git) กรอกค่า แล้วสร้าง Secret ด้วยมือ:
#   kubectl -n lrdi create secret generic bev-claim-backend-env --from-env-file=k8s/overlays/local/secret.env
# DB_SERVER/DB_PORT ของ local ตั้งไว้ใน kustomization.yaml แล้ว (host.docker.internal:3306 — MySQL)
DB_USER=
DB_PASSWORD=
DB_DATABASE=
JWT_SECRET=
