# ค่าที่ต้องใส่ใน Vault path: lrdi-kv/bev-claim/prod  (ExternalSecret ดึงไปสร้าง Secret bev-claim-backend-env)
# ถ้าจะสร้าง Secret ด้วยมือแทน: คัดลอกเป็น secret.env (ไม่ขึ้น git) แล้ว
#   kubectl -n lrdi create secret generic bev-claim-backend-env --from-env-file=k8s/overlays/prod/secret.env
# สร้าง JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DB_SERVER=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
JWT_SECRET=
